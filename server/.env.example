DATABASE_URL="postgresql://xdental_user:YOUR_PASSWORD@localhost:5432/xdental_store?schema=public"
JWT_SECRET="change-this-to-a-long-secret-at-least-32-characters"
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
EMAIL_ENABLED="false"
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Local development seed user. Replace these values outside local development.
SEED_ADMIN_NAME="X Dental Admin"
SEED_ADMIN_EMAIL="admin@xdental.local"
SEED_ADMIN_PASSWORD="Admin123456"
SEED_ADMIN_ROLE="ADMIN"

# Optional. Defaults to 5000.
PORT=5000

# Production only: use none for cross-site frontend/backend, lax for same-site.
# COOKIE_SAME_SITE=none
