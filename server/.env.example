DATABASE_URL="postgresql://xdental_user:YOUR_PASSWORD@localhost:5432/xdental_store?schema=public"
JWT_SECRET="change-this-to-a-long-secret-at-least-32-characters"
# Exact trusted frontend origin(s); separate multiple origins with commas.
# Production requires HTTPS origins and rejects localhost, paths, and malformed URLs.
CLIENT_URL="http://localhost:5173,http://localhost:5174"
# Must be explicitly set to development, test, or production.
NODE_ENV="development"
MAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="X Dental Store"
MAIL_FROM_EMAIL=""
COMPANY_NOTIFICATION_EMAIL=""
CONTACT_NOTIFICATION_EMAIL=""
NEWSLETTER_NOTIFICATION_EMAIL=""
QUOTE_NOTIFICATION_EMAIL=""
PRODUCT_REQUEST_NOTIFICATION_EMAIL=""
MACHINE_INQUIRY_NOTIFICATION_EMAIL=""
SUPPORT_NOTIFICATION_EMAIL=""
APP_BASE_URL=""

# Authenticated browser push. Generate real VAPID keys locally and keep the private key secret.
WEB_PUSH_ENABLED="false"
WEB_PUSH_VAPID_SUBJECT="mailto:notifications@example.com"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# Image uploads use local server/uploads directories in development.
# Production on managed hosting must use durable S3-compatible object storage.
UPLOAD_STORAGE_DRIVER="local"
# UPLOAD_S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# UPLOAD_S3_REGION="auto"
# UPLOAD_S3_BUCKET="xdental-store-production"
# UPLOAD_S3_ACCESS_KEY_ID=""
# UPLOAD_S3_SECRET_ACCESS_KEY=""
# Production should use a custom HTTPS media domain, not an r2.dev URL.
# UPLOAD_S3_PUBLIC_BASE_URL="https://media.example.com"
# UPLOAD_S3_FORCE_PATH_STYLE="false"

# Local development seed user. Replace these values outside local development.
SEED_ADMIN_NAME="X Dental Admin"
SEED_ADMIN_EMAIL="admin@xdental.local"
SEED_ADMIN_PASSWORD="Admin123456"
SEED_ADMIN_ROLE="ADMIN"

# Optional. Defaults to 5000.
PORT=5000

# Production defaults to lax. Use none only for a cross-site HTTPS frontend/API.
# COOKIE_SAME_SITE=lax

# Optional per-process rate-limit maximum overrides. Defaults are documented in README.md.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_PASSWORD_MAX=10
# RATE_LIMIT_SUPPORT_MAX=30
# RATE_LIMIT_QUOTE_MAX=10
# RATE_LIMIT_PRODUCT_REQUEST_MAX=10
# RATE_LIMIT_ORDER_MAX=20
# RATE_LIMIT_SUPPLY_LIST_MAX=200
# RATE_LIMIT_PUSH_SUBSCRIPTION_MAX=30
# RATE_LIMIT_CONTACT_MAX=5
# RATE_LIMIT_NEWSLETTER_MAX=10
# RATE_LIMIT_EMAIL_RETRY_MAX=10
